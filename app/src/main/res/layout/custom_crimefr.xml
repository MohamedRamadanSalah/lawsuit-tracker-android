<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/card_container"
        android:layout_width="340dp"
        android:layout_height="91dp"
        android:background="@drawable/rectangle_bg"
        android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/custom_image_card"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_margin="8dp"
            app:cardCornerRadius="50dp"
        app:cardElevation="0dp"
        android:layout_gravity="center"
            tools:ignore="MissingConstraints">

        <ImageView
            android:id="@+id/custom_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:src="@drawable/unknownimage"
        android:clipToOutline="true" />

    </androidx.cardview.widget.CardView>


    <TextView
        android:id="@+id/custom_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="20dp"
        android:text="Name"
        android:textColor="@color/Green"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toEndOf="@id/custom_image_card"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/custom_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="20dp"
        android:text="Date"
        android:textColor="@color/Green"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/custom_name"
        app:layout_constraintStart_toStartOf="@id/custom_name"
        app:layout_constraintTop_toBottomOf="@id/custom_name" />


    <CheckBox
        android:id="@+id/custom_checkbox"
        android:layout_width="65dp"
        android:layout_height="35dp"
        android:layout_marginStart="132dp"
        android:text="Solved"
        android:textColor="@color/Green"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/custom_date"
        app:layout_constraintTop_toBottomOf="@id/custom_date"
        app:layout_constraintVertical_bias="0.0" />
</androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
